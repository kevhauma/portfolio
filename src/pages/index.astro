---
import Livery from '../layouts/Livery.astro';
import Decal from '../components/Decal.astro';
import Kit from '../components/Kit.astro';
import { github, raceNumber, stack } from '../data/site';
import '../styles/sheet.css';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// The car outline is traced in Inkscape (public/ae86.svg). Only its paths ship; the hidden reference photo stays in the source file.
const carSource = readFileSync(resolve(process.cwd(), 'public/ae86.svg'), 'utf8');
const car = {
  viewBox: carSource.match(/viewBox="([^"]+)"/)![1],
  paths: [...carSource.matchAll(/<path[^>]*?\sd="([^"]+)"/g)].map(m => m[1])
};

const liner = Array.from({ length: 44 }, () =>
  Array.from({ length: 4 }, () => `kevhauma livery kit · sheet 01 · race number ${raceNumber}`).join(' · ')
);
const tones = ['t-green', 't-black', 't-white', 't-red', 't-navy', 't-primer', 't-white'];
// most of the kit is gloss vinyl; the black, the round white and the primer decal are foil, like the 23
const finishes = ['gloss', 'holo', 'holo', 'gloss', 'gloss', 'chrome', 'gloss'] as const;
---
<Livery title="Kevin · frontend developer" description="Kevin is a frontend developer with a bachelor in applied computer science and five years of consultancy work. Race number 23." sec="01" arrival>
  <section class="sheet intro" aria-labelledby="name">
    <div class="liner" aria-hidden="true">{liner.map(l => <span>{l}</span>)}</div>

    <div class="plate">
      <!-- placement guide: the car's side elevation, front in frame, the back running behind the name -->
      <svg class="car" viewBox={car.viewBox} aria-hidden="true">{car.paths.map(d => <path d={d} />)}</svg>

      <Decal class="d-name t-navy" finish="gloss">
        <h1 id="name">Kevin</h1>
      </Decal>

      <Decal class="d-num t-red" round finish="holo" img={`Race number ${raceNumber}`}>
        <span aria-hidden="true">{raceNumber}</span>
      </Decal>

      <Decal class="d-spec t-white" finish="gloss">
        <p class="spec-t">Frontend developer</p>
        <dl class="spec">
          <dt>Degree</dt><dd>Bachelor, applied computer science</dd>
          <dt>Consulting</dt><dd>Five years</dd>
          <dt>Hashcode</dt><dd>#113 worldwide, 2018</dd>
          <dt>Code</dt><dd><a href={github.href}>{github.label}</a></dd>
        </dl>
      </Decal>

      <Decal class="d-note t-green" finish="gloss">
        <p class="note">One person, many interfaces.</p>
      </Decal>

      <p class="stack-label" id="stack-label">Stack, sized by use <span class="ph">placeholder sizes</span></p>
      <ul class="stack" aria-labelledby="stack-label">
        {stack.map((s, i) => (
          <Decal as="li" class={`s${i + 1} ${tones[i]}`} round={i === 2} finish={finishes[i]}>
            {s.name}
          </Decal>
        ))}
      </ul>

    </div>

  </section>

  <Kit current="01" heading="Frontend first.">
    <p>Five years of frontend consultancy, after a bachelor in applied computer science. Outside work: photography, motorsport, travel, music, 3D printing and LED lighting.</p>
    <p>Every sheet in this kit borrows the interface of what it shows: a timing screen for the experience, a map for the miles, a tour poster for the gigs.</p>
  </Kit>
</Livery>

<script>
  import '../scripts/arrival';
  import '../scripts/stickers';
</script>
