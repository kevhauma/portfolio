---
/* Sheet 06: the garage at dusk, drawn as a late-90s anime cel, and the same ten things as a plain list below.
   Each hobby's words live in ./zones/<Zone>.astro (mode "panel" for the caption box, "list" for the list);
   its objects and behaviour live in src/garage/zones/<id>.ts. */
import { zones, type ZoneId } from '../../data/garage';
import Wled from './zones/Wled.astro';
import Printer from './zones/Printer.astro';
import Shelf from './zones/Shelf.astro';
import Quackbot from './zones/Quackbot.astro';
import Home from './zones/Home.astro';
import Keyboards from './zones/Keyboards.astro';
import Jdm from './zones/Jdm.astro';
import Lego from './zones/Lego.astro';
import Bike from './zones/Bike.astro';
import Camera from './zones/Camera.astro';

const content: Record<ZoneId, typeof Wled> = { wled: Wled, printer: Printer, shelf: Shelf, quackbot: Quackbot, home: Home, keyboards: Keyboards, jdm: Jdm, lego: Lego, bike: Bike, camera: Camera };
---
<div class="garage">
  <section class="g-stage" id="garage" aria-label="The garage, an interactive cel-shaded scene" data-garage>
    <canvas data-gl aria-hidden="true"></canvas>
    <div class="g-title">
      <h1>Workbench</h1><span class="bar" aria-hidden="true"></span>
      <p>The garage at dusk, drawn like a late-90s cel. <span class="fine">Point at something, click to look closer.</span><span class="touch">Tap something to look closer; drag sideways to look around.</span></p>
    </div>
    <div class="g-hover" data-hover-label aria-hidden="true"><svg viewBox="0 0 10 12"><path d="M1 1l8 5-8 5z" fill="#E2001A" stroke="#170f1f" stroke-width="1.5" stroke-linejoin="round" /></svg><span></span></div>
    <div class="g-fallback" data-fallback hidden>
      <div class="g-panel">
        <p class="g-fallback-h">This garage needs WebGL, and this browser said no.</p>
        <p>Everything in it is listed <a href="#garage-list">below</a>, with all the facts.</p>
      </div>
    </div>
    <nav class="g-hotbar" data-hotbar aria-label="Look at something in the garage">
      {zones.map(z => <button class="g-hb" type="button" data-zone={z.id}>{z.short}</button>)}
    </nav>
    <section class="g-dbox" data-dbox aria-labelledby="g-dtitle" hidden>
      <div class="g-panel">
        <div class="g-nametab"><h2 id="g-dtitle" tabindex="-1" data-title></h2></div>
        <div class="g-dhead"><button class="g-back" type="button" data-back>Back to the garage <kbd>Esc</kbd></button></div>
        <div class="g-dbody">
          {zones.map(z => { const C = content[z.id]; return <div data-panel={z.id} data-name={z.name} hidden><C mode="panel" /></div>; })}
        </div>
      </div>
    </section>
  </section>

  <section class="g-index" id="garage-list" aria-labelledby="g-idx-title">
    <h2 id="g-idx-title">Everything in the garage</h2>
    <p class="lede">The same ten things as the scene above, in plain words, for anyone who would rather read than wander around a painted garage.</p>
    <ul class="g-list">
      {zones.map(z => { const C = content[z.id]; return (
        <li id={`list-${z.id}`}>
          <h3>{z.name}<small>{z.where}</small></h3>
          <div><C mode="list" /><button class="g-go" type="button" data-go={z.id}>Look at it in the garage</button></div>
        </li>
      ); })}
    </ul>
  </section>
</div>

<script>
  // the scene is the first screen, so it loads straight away; three.js arrives as its own chunk
  const stage = document.querySelector<HTMLElement>('[data-garage]');
  // the engine shows the WebGL fallback itself; anything that lands here is some other failure, so say that instead
  if (stage) import('../../garage/engine').then(m => m.boot(stage)).catch((e: unknown) => {
    console.error('garage:', e);
    stage.querySelector('.g-fallback-h')!.textContent = 'The garage didn’t start in this browser.';
    stage.classList.add('no-gl'); stage.querySelector<HTMLElement>('[data-fallback]')!.hidden = false;
  });
</script>
