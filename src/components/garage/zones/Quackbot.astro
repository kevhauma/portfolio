---
/* Quackbot: the retired Discord bot, as a small chat on its old CRT. */
import Tag from '../Tag.astro';
interface Props { mode: 'panel' | 'list' }
const { mode } = Astro.props;
const cmds = ['!help', '!quack', '!roll', '!uptime', '!about'];
---
{mode === 'panel' ? (
  <>
    <p>Quackbot was the Discord bot Kevin built. It ran from 2017 to 2020 for one community of about 2,000 members, and is retired now.</p>
    <div class="g-crt" role="log" aria-live="polite" aria-label="Quackbot chat" data-log><p><span class="bot">quackbot&gt;</span> online. type !help</p></div>
    <div class="g-row">{cmds.map(c => <button class="g-btn" type="button" data-cmd={c}>{c}</button>)}</div>
    <form class="g-cmd" data-form><label class="g-sr" for="qb-in">Command</label><input class="g-cmdline" id="qb-in" autocomplete="off" placeholder="type a command" spellcheck="false" /><button class="g-btn" type="submit">Send</button></form>
    <p class="g-note"><Tag kind="illustrative" />These replies are written for this page, not Quackbot's real output.</p>
    <p><a href="/projects/quackbot/">The full Quackbot story</a></p>
  </>
) : (
  <>
    <p>The Discord bot Kevin built. It ran from 2017 to 2020 for one community of about 2,000 members, and is retired now. <Tag kind="illustrative" />the replies there are written for this page.</p>
    <p><a href="/projects/quackbot/">The full Quackbot story</a></p>
  </>
)}
