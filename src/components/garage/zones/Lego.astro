---
/* Lego on the corner rack. */
import Tag from '../Tag.astro';
interface Props { mode: 'panel' | 'list' }
const { mode } = Astro.props;
const builds = ['the tower', 'the house', 'the car'];
---
{mode === 'panel' ? (
  <>
    <p>Lego.</p>
    <ul class="g-facts">{builds.map((b, i) => <li>Build {i + 1}, {b}. <Tag />set name</li>)}</ul>
    <p class="g-note">Which sets these really are follows later; the three builds here are stand-ins.</p>
  </>
) : (
  <>
    <p>Lego.</p>
    <p><Tag />Which sets these are.</p>
  </>
)}
