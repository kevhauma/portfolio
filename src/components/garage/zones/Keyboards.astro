---
/* Keyboards on the desk. */
import Tag from '../Tag.astro';
interface Props { mode: 'panel' | 'list' }
const { mode } = Astro.props;
---
{mode === 'panel' ? (
  <>
    <p>Mechanical keyboards.</p>
    <ul class="g-facts">
      <li><b>Board A</b>: a 65% layout in retro beige, the one with the red Escape. <Tag /></li>
      <li><b>Board B</b>: a 60% layout on a stand, green Enter. <Tag /></li>
    </ul>
    <p class="g-note">Switches, plates and keycap sets: to follow.</p>
  </>
) : (
  <>
    <p>Mechanical keyboards.</p>
    <p><Tag />Which boards and switches Kevin uses.</p>
  </>
)}
