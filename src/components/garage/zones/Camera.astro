---
/* The camera on its tripod: the door to photography, which lives on the map. */
import Tag from '../Tag.astro';
interface Props { mode: 'panel' | 'list' }
const { mode } = Astro.props;
---
{mode === 'panel' ? (
  <>
    <p>Photography. The photos live on <a href="/map/">the map</a>, pinned where they were taken.</p>
    <p class="g-note"><Tag />Body and lenses.</p>
  </>
) : (
  <>
    <p>Photography. The photos live on <a href="/map/">the map</a>.</p>
    <p><Tag />Body and lenses.</p>
  </>
)}
