---
/* The scene every Projects page sits in: a walnut desk, the manual on it in its navy cloth
   hardcover, ribbons out of the gutter and pens beside it. The spread goes in the slot.
   The book arrives shut and opens itself (book.ts); its cover is drawn here. */
import ThumbIndex from './ThumbIndex.astro';
import '@fontsource-variable/archivo/wdth.css';
import '../../styles/manual.css';

interface Props { current?: string }
const { current } = Astro.props;
---
<section class="desk">
  <div class="scene">
    <div class="book">
      <div class="block">
        <slot />
        <ThumbIndex current={current} />
      </div>
      <span class="light" aria-hidden="true"></span>
      <span class="ribbon r1" aria-hidden="true"></span>
      <span class="ribbon r2" aria-hidden="true"></span>
    </div>
    <div class="cover-rig" aria-hidden="true">
      <span class="cast"></span>
      <div class="cover">
        <div class="cv-face cv-front">
          <p class="cv-kind">Workshop manual</p>
          <p class="cv-title">Projects</p>
          <p class="cv-sub">Six chapters<br />and the fuse box</p>
          <span class="cv-stripes"><i></i><i></i></span>
          <p class="cv-foot"><span class="cv-num">23</span>Kevin</p>
          <span class="shade"></span>
        </div>
        <div class="cv-face cv-back"><div class="cv-in"></div><span class="shade"></span></div>
      </div>
    </div>
    <div class="pens" aria-hidden="true">
      <svg class="pen pen-ball" viewBox="0 0 20 320" width="20" height="320">
        <defs>
          <linearGradient id="cyl" x1="0" x2="1">
            <stop offset="0" stop-color="#000" stop-opacity=".45" />
            <stop offset=".32" stop-color="#fff" stop-opacity=".32" />
            <stop offset=".55" stop-color="#fff" stop-opacity="0" />
            <stop offset="1" stop-color="#000" stop-opacity=".4" />
          </linearGradient>
          <linearGradient id="steel" x1="0" x2="1">
            <stop offset="0" stop-color="#6F757D" /><stop offset=".4" stop-color="#E9ECEF" /><stop offset="1" stop-color="#5F656D" />
          </linearGradient>
        </defs>
        <rect x="3" y="0" width="14" height="22" rx="6" fill="#13254F" />
        <rect x="2" y="16" width="16" height="96" rx="4" fill="#13254F" />
        <rect x="3" y="108" width="14" height="190" rx="3" fill="#13254F" />
        <rect x="2" y="0" width="16" height="298" rx="6" fill="url(#cyl)" />
        <rect x="15" y="22" width="4" height="74" rx="2" fill="url(#steel)" />
        <rect x="3" y="110" width="14" height="4" fill="url(#steel)" />
        <path d="M4 298h12l-4 16h-4z" fill="url(#steel)" />
        <path d="M9 314h2l-1 5z" fill="#2B2E33" />
      </svg>
      <svg class="pen pen-felt" viewBox="0 0 20 300" width="20" height="300">
        <rect x="2" y="0" width="16" height="70" rx="5" fill="#16181D" />
        <rect x="3" y="66" width="14" height="214" rx="4" fill="#E2001A" />
        <rect x="2" y="0" width="16" height="280" rx="5" fill="url(#cyl)" />
        <rect x="3" y="64" width="14" height="3" fill="#000" opacity=".35" />
        <path d="M5 280h10l-2 10h-6z" fill="#16181D" />
        <path d="M8 290h4l-1 8h-2z" fill="#E2001A" />
      </svg>
      <svg class="pen pen-pencil" viewBox="0 0 14 300" width="14" height="300">
        <rect x="3" y="0" width="8" height="18" rx="2" fill="#2A2C31" />
        <rect x="2" y="16" width="10" height="250" rx="3" fill="#9EA3AA" />
        <rect x="2" y="60" width="10" height="70" fill="#3A3D43" />
        <rect x="2" y="0" width="10" height="266" rx="3" fill="url(#cyl)" />
        <rect x="10" y="20" width="3" height="40" rx="1.5" fill="url(#steel)" />
        <path d="M3 266h8l-2 18h-4z" fill="url(#steel)" />
        <rect x="6.4" y="284" width="1.2" height="10" fill="#2B2E33" />
      </svg>
    </div>
  </div>
</section>

<script>
  import '../../scripts/book';
</script>
