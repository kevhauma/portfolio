---
/* The dash and the console, flat cel bands with ink #0A1330: the dash top pad, the passenger side (the sheet's
   sticker, the vent with three gig stubs, the glovebox lid with the lede), the centre stack behind the deck and the
   climate strip, the console with the gear lever and a cup of water, and the knee panel and column under the cluster. */
import { gigs, lede, placeholder } from '../../data/music';
import Stub from './Stub.astro';
const vent = gigs.filter(g => g.at === 'vent');
