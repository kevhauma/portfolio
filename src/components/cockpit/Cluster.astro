  <path d="M1011.5 327.5H1426.5V352H1017L1011.5 374Z" fill="#020206" opacity=".55" />
  <!-- one highlight on the lens -->
  <path d="M1066 356H1080L1052 548H1038Z" fill="#fff" opacity=".07" />
  <path d="M1086 356H1091L1063 548H1058Z" fill="#fff" opacity=".07" />
  <path d="M996 560V306Q996 290 1012 290H1436V560" fill="none" stroke={INK} stroke-width="3" />
  <rect x="996" y="550" width="440" height="12" fill="#2E2F3B" stroke={INK} stroke-width="2.5" />
  <rect x="1012" y="551" width="200" height="2.5" fill="#4A4B5A" />
</svg>
