---
import { github, stack } from '../data/site';
import { chapters, supplement, projectHref, period, duration } from '../data/projects';
import { team, since, qualifying, sectors } from '../data/experience';

const q = qualifying.internship;
// the clients Kevin was placed with, in order, without Zinderlabs' own work or the NDA client
const clients = [...new Set(sectors.filter(s => s.client !== team && !s.nda).map(s => s.client))];
---
<main id="pit" class="pit" aria-labelledby="pit-title">
  <p class="pit-flag">Pit limiter is on: the livery is off and this is the whole site in one plain column. Switch it off at the top right for the full version.</p>
  <h1 id="pit-title">Kevin</h1>
  <p class="pit-lede">Frontend developer at {team} since {since.slice(0, 4)}. {qualifying.title}, {qualifying.school} {qualifying.years}.</p>
  <p>Code on <a href={github.href}>{github.label}</a>.</p>

  <h2 id="pit-stack">Stack</h2>
  <ul class="pit-stack">{stack.map(s => <li>{s.name}</li>)}</ul>

  <h2 id="pit-experience">Experience</h2>
  <ol class="pit-rows">
    <li><span class="when">{since.slice(0, 4)} – now</span><b>{team}</b><span class="d">Consultant, frontend and full-stack · clients include {clients.join(', ')}</span></li>
    <li><span class="when">{qualifying.years}</span><b>{qualifying.title}</b><span class="d">{qualifying.school} · internship at {q.client} on {q.project}, {q.start.slice(0, 4)}</span></li>
  </ol>

  <h2 id="pit-projects">Projects</h2>
  <ol class="pit-rows">
    {chapters.map(p => (
      <li><span class="when">{period(p)}</span><b><a href={projectHref(p)}>{p.title}</a>{p.own ? ' · own build' : ` · ${p.client}`}</b><span class="d">{p.line}</span></li>
    ))}
  </ol>
  <h3 class="pit-sub">Other work</h3>
  <ol class="pit-rows">
    {supplement.map(p => (
      <li><span class="when">{period(p)} · {duration(p)}</span><b><a href={projectHref(p)}>{p.nda ? 'Building installation planner' : p.title}</a> · {p.nda ? 'construction tech client, under NDA' : p.client}</b><span class="d">{p.summary[0]}</span></li>
    ))}
  </ol>

  <h2 id="pit-contact">Contact <span class="ph">placeholder</span></h2>
  <p>Email and LinkedIn go here once Kevin adds them.</p>
  <div class="pit-actions">
    <a class="pit-btn" aria-disabled="true" role="link">Download CV <span class="ph">not uploaded</span></a>
  </div>
</main>
