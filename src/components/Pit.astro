---
import { github, projects, stack } from '../data/site';
---
<main id="pit" class="pit" aria-labelledby="pit-title">
  <p class="pit-flag">Pit limiter is on: the livery is off and this is the whole site in one plain column. Switch it off at the top right for the full version.</p>
  <h1 id="pit-title">Kevin</h1>
  <p class="pit-lede">Frontend developer. Bachelor in applied computer science, five years of consultancy work.</p>
  <p>Code on <a href={github.href}>{github.label}</a>.</p>

  <h2 id="pit-stack">Stack</h2>
  <ul class="pit-stack">{stack.map(s => <li>{s.name}</li>)}</ul>

  <h2 id="pit-experience">Experience <span class="ph">placeholder</span></h2>
  <ol class="pit-rows">
    <li><span class="when">20XX – now</span><b>Client name</b><span class="d">Role · stack · what shipped</span></li>
    <li><span class="when">20XX – 20XX</span><b>Client name</b><span class="d">Role · stack · what shipped</span></li>
    <li><span class="when">20XX – 20XX</span><b>Client name</b><span class="d">Role · stack · what shipped</span></li>
    <li><span class="when">20XX</span><b>Bachelor, applied computer science</b><span class="d">School name</span></li>
  </ol>

  <h2 id="pit-projects">Projects</h2>
  <ol class="pit-rows">
    {projects.map(p => (
      <li><span class="when">{p.lang}</span><b><a href={p.href}>{p.name}</a></b><span class="d">{p.d}</span></li>
    ))}
  </ol>

  <h2 id="pit-contact">Contact <span class="ph">placeholder</span></h2>
  <p>Email and LinkedIn go here once Kevin adds them.</p>
  <div class="pit-actions">
    <a class="pit-btn" aria-disabled="true" role="link">Download CV <span class="ph">not uploaded</span></a>
  </div>
</main>
